{
  // trace.lucabottani.dev: collection point for Forever One Button logs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fob-trace",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "trace.lucabottani.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Workers KV: each log expires on its own after 180 days (expirationTtl).
  "kv_namespaces": [{ "binding": "SHARES", "id": "a3424f420b3342b4b3f020c0fc580b41" }],
  // At most 5 logs per minute from one connection.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
  // ADMIN_TOKEN is a secret: wrangler secret put ADMIN_TOKEN
}
